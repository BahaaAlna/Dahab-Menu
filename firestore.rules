rules_version = '2';

/* ============================================================
     قواعد الحماية — وهي الحماية الحقيقية الوحيدة في المشروع
   الموقع كله ملفات ساكنة، فلا يوجد خادم يحمي شيئاً.
   كل شيء ممنوع افتراضياً، ولا يُسمح إلا بما هو مكتوب أدناه.

   النشر:  firebase deploy --only firestore:rules

    لوحة الإدارة تدخل الآن بحساب موظف حقيقي (بريد وكلمة مرور)
      من Firebase Authentication، لا بـ signInAnonymously، ولم يعد
      في الكود أي كلمة مرور.

     يجب أن يكون UID حساب الموظف مذكوراً في isStaff() أدناه، وإلا
      تعذّر على أي أحد تعديل قائمة الطعام أو مفاتيح الميزات.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- من هو الموظف؟ ----------
       لم تبقَ في الموقع حسابات زبائن، فالموظف وحده من يسجّل دخولاً.
       ومع ذلك يُحدَّد بالـ UID لا بمجرّد امتلاك حساب: الـ UID لا
       يتغيّر ولا يُنتحَل، بخلاف البريد الذي يستطيع صاحبه تعديله،
       ولأن أي حساب يُنشَأ في المشروع مستقبلاً لا ينبغي أن يصير
       موظفاً لمجرّد وجوده.

       طريقة الحصول على الـ UID:
       Firebase Console ← Authentication ← Users ← عمود User UID

       يُوضَع UID كل موظف هنا. مثال:
       ['kJ3mX...','p9Lq2...'] */
    function isStaff() {
      return request.auth != null
        && request.auth.uid in [
             '439ihZVowhYT9A5AAHlz56eovLo2'
           ];
    }

    /* ---------- التحقق من شكل الطلب ----------
       يُتحقَّق من سلامة شكل الطلب الوارد من الزبون، كي لا يُلقي أحد
       بيانات تالفة أو ضخمة في قاعدة البيانات. */
    function isValidCustomer(c) {
      return c is map
        && c.keys().hasAll(['name', 'phone'])
        && c.keys().hasOnly(['name', 'phone', 'address'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && c.phone is string && c.phone.size() >= 6 && c.phone.size() <= 20
        && (!('address' in c) || (c.address is string && c.address.size() <= 200));
    }

    /* طلب الطاولة لا يحتاج رقماً ولا عنواناً: يُحمَل إلى الطاولة
       ولا يُوصَّل. والاسم وحده اختياري يعين النادل، فإن أُرسل
       وجب أن يكون اسماً لا حمولةً كيفما اتّفقت. */
    function isValidTableCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60;
    }

    /* ---------- مفتاح الطاولة ----------
       لكل طاولة وثيقة في «tables» تحمل مفتاحاً سرّياً يدخل في رابط
       رمزها. إعادة توليد الرمز تبدّل المفتاح، فيتعطّل الرمز القديم
       فوراً. وما لا وثيقة له (طاولة لم يُولَّد لها رمز بعد) يبقى على
       حاله دون مفتاح، كي لا تتعطّل رموز مطبوعة قبل هذه الميزة. */
    function tableKeyOk(d) {
      let ref = /databases/$(database)/documents/tables/$(string(d.table));
      return !exists(ref)
        || ('tableKey' in d && d.tableKey == get(ref).data.token);
    }

    function isValidOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'items', 'total', 'status', 'createdAt'])
        // لا خانة uid: لا حسابات في الموقع، وكل طلب طلبُ ضيف
        && d.keys().hasOnly(['type', 'table', 'items', 'total', 'status', 'createdAt', 'customer', 'note', 'tableKey'])
        && d.type in ['delivery', 'table']
        && d.status == 'new'
        && d.createdAt == request.time
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total >= 0 && d.total < 10000000
        // أقل مجموع لطلب التوصيل: 200 ل.س (ويتكرّر في config.js)
        && (d.type != 'delivery' || d.total >= 200)
        && (d.type != 'table' || (d.table is int && d.table > 0 && d.table <= 200))
        && (d.type != 'table' || tableKeyOk(d))
        && (d.type == 'table' || !('tableKey' in d))
        && (!('tableKey' in d) || (d.tableKey is string && d.tableKey.size() <= 64))
        && (d.type != 'table' || !('customer' in d) || isValidTableCustomer(d.customer))
        && (d.type != 'delivery' || isValidCustomer(d.customer))
        // خانة الطاولة لطلب الطاولة وحده
        && (d.type == 'table' || !('table' in d))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    /* ---------- قائمة الطعام ----------
       الجميع يقرأ، والموظف وحده يعدّل. */
    match /menu_sections/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /menu_items/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* النسخة المجمّعة — وثيقة واحدة يقرأها الزبائن.
       قراءة واحدة بدل ثمانٍ وثمانين، وهي ما يُبقينا في الخطة المجانية. */
    match /menu_public/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- الطلبات ----------
       الطلب مفتوح بلا تسجيل دخول: يكتب الزبون اسمه ورقمه وعنوانه
       في نافذة التأكيد ويُرسل. والشكل وحده هو ما يُتحقَّق منه.

         وهذا يعني أن إنشاء الطلب مكشوف للعلن: الموقع ملفات ساكنة
          ومفتاح الـ API ظاهر فيها، فيستطيع أي أحد مناداة Firestore
          مباشرة وإغراق المجموعة بطلبات وهمية مطابقة للشكل. لا تمنع
          القواعد ذلك، لأن المطلوب طلب بلا هويّة. وما يحدّ منه:
          تفعيل App Check، أو إعادة اشتراط تسجيل الدخول ولو مجهولاً
          (signInAnonymously)، أو مراقبة عدّاد الكتابات في Console.

       والقراءة للموظف وحده: لا حسابات، فلا هويّة يُنسَب إليها طلب
       ولا زبون يرجع ليقرأ طلبه. وكذلك التعديل والحذف. */
    match /orders/{id} {
      allow create: if isValidOrder();
      allow read, update, delete: if isStaff();
    }

    /* ---------- مفاتيح الطاولات ----------
       سرّية: الموظف وحده يقرأ ويكتب. والقاعدة أعلاه تقرأها بـ get()
       دون أن يُتاح للزبون قراءتها. */
    match /tables/{id} {
      allow read, write: if isStaff();
    }

    /* ---------- مفاتيح تشغيل الميزات ----------
       وثيقة واحدة تحدّد الميزات المتاحة للزبائن. الجميع يقرأ،
       لأن صفحة الترحيب تحتاجها قبل أي تسجيل دخول،
       والموظف وحده يكتب. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- أجهزة الموظفين لإشعارات Push ----------
       معرّف الوثيقة هو رمز الجهاز من FCM. يكتبها الموظف لنفسه من
       اللوحة، ويقرؤها عامل الإشعارات بحساب خدمة لا تمرّ به القواعد. */
    match /admin_tokens/{token} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['uid', 'ua', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    /* push_log: سجلّ ما أُرسل عنه إشعار، كي لا يتكرّر. يكتبه العامل
       وحده بحساب الخدمة، فيبقى مغلقاً على الجميع بالقاعدة أدناه. */

    /* ---------- ما عدا ذلك: مرفوض ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
