rules_version = '2';

/* ============================================================
   🔒  قواعد الحماية — هي الحماية الحقيقية الوحيدة بالمشروع
   الموقع كله ملفات ساكنة، فما في سيرفر يحمي شي.
   كل شي ممنوع افتراضياً، وما منسمح غير بيلي مكتوب تحت.

   النشر:  firebase deploy --only firestore:rules

   ⚠️⚠️  قبل ما ترفع هالقواعد اقرأ هالسطرين:

   ١) لوحة الإدارة (admin.js) لسا بتفوت بـ signInAnonymously
      وكلمة سر مكتوبة بالكود. القواعد تحت ما بتعترف فيها،
      فإذا رفعت هلأ الداشبورد بيوقف عن الكتابة.
      لازم أول شي تعمل حساب موظف وتحوّل admin.js عليه.

   ٢) لازم تحط UID الموظف بقائمة isStaff() تحت، وإلا ما في حدا
      بيقدر يعدّل المنيو أبداً.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- مين الموظف؟ ----------
       ما منقدر نقول «يلي عنده حساب إيميل/كلمة سر» — لأن
       الزباين كمان صار عندهن حسابات بنفس الطريقة
       (رقم الموبايل متحوّل لإيميل شكلي بـ auth.js).

       فمنحدد الموظفين بالـ UID بالذات. الـ UID ما بينغيّر
       ولا بينتحل، بعكس الإيميل يلي بيقدر المستخدم يعدّله.

       كيف تجيب الـ UID:
       Firebase Console → Authentication → Users → عمود User UID

       حط UID كل موظف هون. مثال:
       ['kJ3mX...','p9Lq2...'] */
    function isStaff() {
      return request.auth != null
        && request.auth.uid in [
             'ضع_UID_حساب_الموظف_هنا'
           ];
    }

    /** الزبون نفسه — صاحب الحساب */
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* ---------- التحقق من شكل الطلب ----------
       منتأكد إن الطلب الجاي من الزبون شكله سليم، حتى ما حد يرمي
       بيانات خربانة أو ضخمة بقاعدة البيانات. */
    function isValidCustomer(c) {
      return c is map
        && c.keys().hasAll(['name', 'phone'])
        && c.keys().hasOnly(['name', 'phone', 'address'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && c.phone is string && c.phone.size() >= 6 && c.phone.size() <= 20
        && (!('address' in c) || (c.address is string && c.address.size() <= 200));
    }

    function isValidOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'type', 'items', 'total', 'status', 'createdAt'])
        && d.keys().hasOnly(['uid', 'type', 'table', 'items', 'total', 'status', 'createdAt', 'customer', 'note'])
        // الطلب لازم يكون باسم صاحب الجلسة — ما حدا يطلب باسم غيره
        && d.uid == request.auth.uid
        && d.type in ['delivery', 'table']
        && d.status == 'new'
        && d.createdAt == request.time
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total >= 0 && d.total < 10000000
        && (d.type != 'table' || (d.table is number && d.table > 0 && d.table <= 200))
        && (d.type != 'delivery' || isValidCustomer(d.customer))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    /* ---------- المنيو ----------
       الكل يقرا، الموظف بس يعدّل. */
    match /menu_sections/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /menu_items/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* النسخة المجمّعة — وثيقة واحدة يقراها الزباين.
       قراءة واحدة بدل ٨٨، وهي يلي بتخلينا بالمجاني. */
    match /menu_public/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- ملف الزبون ----------
       الاسم والرقم والعنوان — منخزنهن حتى الطلب الجاي يجي
       معبّى. كل زبون بيشوف ملفه هو بس. */
    match /customers/{uid} {
      // القراءة: صاحب الملف، أو الموظف وقت يأكد الطلب
      allow read: if isOwner(uid) || isStaff();

      // الكتابة: صاحب الملف بس، وبشكل محدود
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address'])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 60))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20))
        && (!('address' in request.resource.data)
            || (request.resource.data.address is string
                && request.resource.data.address.size() <= 200));
    }

    /* ---------- الطلبات ----------
       ما في طلب بدون تسجيل دخول. الزبون بيبعت طلب باسمه هو،
       وبيقدر يتابع طلباته هو بس — ما بيشوف طلبات غيره ولا
       بيعدّل ولا بيحذف. الموظف بيقرا الكل ويغيّر الحالة. */
    match /orders/{id} {
      allow create: if request.auth != null && isValidOrder();
      allow read: if isStaff() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isStaff();
    }

    /* ---------- مفاتيح تشغيل الميزات ----------
       وثيقة واحدة تقول أي ميزة مفتوحة للزبائن. الكل يقرأ،
       لأن صفحة الترحيب تحتاجها قبل أي تسجيل دخول.
       الموظف وحده يكتب. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- أي شي تاني: مرفوض ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
