rules_version = '2';

/* ============================================================
   🔒  قواعد الحماية — وهي الحماية الحقيقية الوحيدة في المشروع
   الموقع كله ملفات ساكنة، فلا يوجد خادم يحمي شيئاً.
   كل شيء ممنوع افتراضياً، ولا يُسمح إلا بما هو مكتوب أدناه.

   النشر:  firebase deploy --only firestore:rules

   ✅ لوحة الإدارة تدخل الآن بحساب موظف حقيقي (بريد وكلمة مرور)
      من Firebase Authentication، لا بـ signInAnonymously، ولم يعد
      في الكود أي كلمة مرور.

   ⚠️  يجب أن يكون UID حساب الموظف مذكوراً في isStaff() أدناه، وإلا
      تعذّر على أي أحد تعديل قائمة الطعام أو مفاتيح الميزات.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- من هو الموظف؟ ----------
       لا يصحّ القول «من يملك حساب بريد وكلمة مرور»، لأن الزبائن
       صارت لهم حسابات بالطريقة ذاتها (رقم الموبايل محوَّل إلى
       بريد شكلي في auth.js).

       لذلك يُحدَّد الموظفون بالـ UID تحديداً، فهو لا يتغيّر ولا
       يُنتحَل، بخلاف البريد الذي يستطيع المستخدم تعديله.

       طريقة الحصول على الـ UID:
       Firebase Console ← Authentication ← Users ← عمود User UID

       يُوضَع UID كل موظف هنا. مثال:
       ['kJ3mX...','p9Lq2...'] */
    function isStaff() {
      return request.auth != null
        && request.auth.uid in [
             '439ihZVowhYT9A5AAHlz56eovLo2'
           ];
    }

    /** الزبون نفسه — صاحب الحساب */
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* ---------- التحقق من شكل الطلب ----------
       يُتحقَّق من سلامة شكل الطلب الوارد من الزبون، كي لا يُلقي أحد
       بيانات تالفة أو ضخمة في قاعدة البيانات. */
    function isValidCustomer(c) {
      return c is map
        && c.keys().hasAll(['name', 'phone'])
        && c.keys().hasOnly(['name', 'phone', 'address'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && c.phone is string && c.phone.size() >= 6 && c.phone.size() <= 20
        && (!('address' in c) || (c.address is string && c.address.size() <= 200));
    }

    function isValidOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'type', 'items', 'total', 'status', 'createdAt'])
        && d.keys().hasOnly(['uid', 'type', 'table', 'items', 'total', 'status', 'createdAt', 'customer', 'note'])
        // يجب أن يكون الطلب باسم صاحب الجلسة، فلا يطلب أحد باسم غيره
        && d.uid == request.auth.uid
        && d.type in ['delivery', 'table']
        && d.status == 'new'
        && d.createdAt == request.time
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total >= 0 && d.total < 10000000
        && (d.type != 'table' || (d.table is number && d.table > 0 && d.table <= 200))
        && (d.type != 'delivery' || isValidCustomer(d.customer))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    /* ---------- قائمة الطعام ----------
       الجميع يقرأ، والموظف وحده يعدّل. */
    match /menu_sections/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /menu_items/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* النسخة المجمّعة — وثيقة واحدة يقرأها الزبائن.
       قراءة واحدة بدل ثمانٍ وثمانين، وهي ما يُبقينا في الخطة المجانية. */
    match /menu_public/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- ملف الزبون ----------
       الاسم والرقم وثلاثة عناوين محفوظة، أحدها افتراضي. ولا يرى
       كل زبون سوى ملفه هو.

       ولمَ خانات بأسماء ثابتة (a1 a2 a3) لا مصفوفة عناوين؟ لأن
       لغة القواعد لا تمرّ على عناصر المصفوفة، فلا سبيل للتحقّق من
       طول كل عنوان. أما الخانات الثابتة فيُتحقَّق من كل واحدة. */

    function validAddress(a) {
      return a is map
        && a.keys().hasOnly(['label', 'text'])
        && (!('label' in a) || (a.label is string && a.label.size() <= 30))
        && (!('text' in a) || (a.text is string && a.text.size() <= 200));
    }

    function validAddresses(d) {
      return !('addresses' in d) || (
        d.addresses is map
        && d.addresses.keys().hasOnly(['a1', 'a2', 'a3'])
        && (!('a1' in d.addresses) || validAddress(d.addresses.a1))
        && (!('a2' in d.addresses) || validAddress(d.addresses.a2))
        && (!('a3' in d.addresses) || validAddress(d.addresses.a3))
      );
    }

    function validProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'phone', 'addresses', 'defaultAddress'])
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('defaultAddress' in d)
            || (d.defaultAddress is string
                && d.defaultAddress in ['', 'a1', 'a2', 'a3']))
        && validAddresses(d);
    }

    /* الرقم هو هويّة الحساب: البريد الشكلي مبنيّ منه في auth.js،
       فلو غيّره الزبون لتناقض ملفه مع حساب دخوله. لذلك يُثبَّت هنا
       لا في الواجهة، لأن الموقع ملفات ساكنة وأي أحد يستطيع مناداة
       Firestore مباشرة. */
    function phoneFromAccount() {
      return request.auth.token.email.split('@')[0];
    }

    match /customers/{uid} {
      // القراءة: صاحب الملف، أو الموظف عند تأكيد الطلب
      allow read: if isOwner(uid) || isStaff();

      // الإنشاء: الرقم المخزَّن لا بدّ أن يطابق رقم حساب الدخول
      allow create: if isOwner(uid)
        && validProfile()
        && request.resource.data.phone == phoneFromAccount();

      // التعديل: كل شيء قابل للتغيير عدا الرقم
      allow update: if isOwner(uid)
        && validProfile()
        && request.resource.data.phone == resource.data.phone;

      // لا حذف: الطلبات السابقة تشير إلى صاحبها
      allow delete: if false;
    }

    /* ---------- الطلبات ----------
       لا طلب دون تسجيل دخول. يرسل الزبون طلباً باسمه هو، ويتابع
       طلباته هو وحدها، فلا يرى طلبات غيره ولا يعدّلها ولا يحذفها.
       أما الموظف فيقرأ الجميع ويغيّر الحالة. */
    match /orders/{id} {
      allow create: if request.auth != null && isValidOrder();
      allow read: if isStaff() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isStaff();
    }

    /* ---------- مفاتيح تشغيل الميزات ----------
       وثيقة واحدة تحدّد الميزات المتاحة للزبائن. الجميع يقرأ،
       لأن صفحة الترحيب تحتاجها قبل أي تسجيل دخول،
       والموظف وحده يكتب. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- ما عدا ذلك: مرفوض ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
