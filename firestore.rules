rules_version = '2';

/* ============================================================
   🔒  قواعد الحماية — وهي الحماية الحقيقية الوحيدة في المشروع
   الموقع كله ملفات ساكنة، فلا يوجد خادم يحمي شيئاً.
   كل شيء ممنوع افتراضياً، ولا يُسمح إلا بما هو مكتوب أدناه.

   النشر:  firebase deploy --only firestore:rules

   ⚠️⚠️  يجب قراءة الملاحظتين الآتيتين قبل رفع هذه القواعد:

   ١) ما زالت لوحة الإدارة (admin.js) تدخل عبر signInAnonymously
      وكلمة مرور مكتوبة في الكود، والقواعد أدناه لا تعترف بذلك.
      فإذا رُفعت القواعد الآن توقّفت اللوحة عن الكتابة. ويجب أولاً
      إنشاء حساب موظف وتحويل admin.js إليه.

   ٢) يجب وضع UID الموظف في قائمة isStaff() أدناه، وإلا تعذّر على
      أي أحد تعديل قائمة الطعام إطلاقاً.
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- من هو الموظف؟ ----------
       لا يصحّ القول «من يملك حساب بريد وكلمة مرور»، لأن الزبائن
       صارت لهم حسابات بالطريقة ذاتها (رقم الموبايل محوَّل إلى
       بريد شكلي في auth.js).

       لذلك يُحدَّد الموظفون بالـ UID تحديداً، فهو لا يتغيّر ولا
       يُنتحَل، بخلاف البريد الذي يستطيع المستخدم تعديله.

       طريقة الحصول على الـ UID:
       Firebase Console ← Authentication ← Users ← عمود User UID

       يُوضَع UID كل موظف هنا. مثال:
       ['kJ3mX...','p9Lq2...'] */
    function isStaff() {
      return request.auth != null
        && request.auth.uid in [
             'ضع_UID_حساب_الموظف_هنا'
           ];
    }

    /** الزبون نفسه — صاحب الحساب */
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    /* ---------- التحقق من شكل الطلب ----------
       يُتحقَّق من سلامة شكل الطلب الوارد من الزبون، كي لا يُلقي أحد
       بيانات تالفة أو ضخمة في قاعدة البيانات. */
    function isValidCustomer(c) {
      return c is map
        && c.keys().hasAll(['name', 'phone'])
        && c.keys().hasOnly(['name', 'phone', 'address'])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && c.phone is string && c.phone.size() >= 6 && c.phone.size() <= 20
        && (!('address' in c) || (c.address is string && c.address.size() <= 200));
    }

    function isValidOrder() {
      let d = request.resource.data;
      return d.keys().hasAll(['uid', 'type', 'items', 'total', 'status', 'createdAt'])
        && d.keys().hasOnly(['uid', 'type', 'table', 'items', 'total', 'status', 'createdAt', 'customer', 'note'])
        // يجب أن يكون الطلب باسم صاحب الجلسة، فلا يطلب أحد باسم غيره
        && d.uid == request.auth.uid
        && d.type in ['delivery', 'table']
        && d.status == 'new'
        && d.createdAt == request.time
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.total is number && d.total >= 0 && d.total < 10000000
        && (d.type != 'table' || (d.table is number && d.table > 0 && d.table <= 200))
        && (d.type != 'delivery' || isValidCustomer(d.customer))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    /* ---------- قائمة الطعام ----------
       الجميع يقرأ، والموظف وحده يعدّل. */
    match /menu_sections/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /menu_items/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* النسخة المجمّعة — وثيقة واحدة يقرأها الزبائن.
       قراءة واحدة بدل ثمانٍ وثمانين، وهي ما يُبقينا في الخطة المجانية. */
    match /menu_public/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- ملف الزبون ----------
       الاسم والرقم والعنوان، وتُخزَّن ليأتي الطلب التالي معبّأً.
       ولا يرى كل زبون سوى ملفه هو. */
    match /customers/{uid} {
      // القراءة: صاحب الملف، أو الموظف عند تأكيد الطلب
      allow read: if isOwner(uid) || isStaff();

      // الكتابة: صاحب الملف وحده، وبصورة محدودة
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'address'])
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 60))
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string
                && request.resource.data.phone.size() <= 20))
        && (!('address' in request.resource.data)
            || (request.resource.data.address is string
                && request.resource.data.address.size() <= 200));
    }

    /* ---------- الطلبات ----------
       لا طلب دون تسجيل دخول. يرسل الزبون طلباً باسمه هو، ويتابع
       طلباته هو وحدها، فلا يرى طلبات غيره ولا يعدّلها ولا يحذفها.
       أما الموظف فيقرأ الجميع ويغيّر الحالة. */
    match /orders/{id} {
      allow create: if request.auth != null && isValidOrder();
      allow read: if isStaff() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isStaff();
    }

    /* ---------- مفاتيح تشغيل الميزات ----------
       وثيقة واحدة تحدّد الميزات المتاحة للزبائن. الجميع يقرأ،
       لأن صفحة الترحيب تحتاجها قبل أي تسجيل دخول،
       والموظف وحده يكتب. */
    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    /* ---------- ما عدا ذلك: مرفوض ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
